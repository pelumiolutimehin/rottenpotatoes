<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<% sortable_columns = { "title" => "Title", "rating" => "Rating", "release_date" => "Release date" } %>

<table id="movies">
  <colgroup>
    <% sortable_columns.each_key do |column| %>
      <%= tag.col class: ("sorted-#{@sort_direction}" if @sort_column == column) %>
    <% end %>
    <col>
  </colgroup>
  <thead>
    <tr>
      <% sortable_columns.each do |column, label| %>
        <th scope="col">
          <%= sortable_header(label, column) %>
        </th>
      <% end %>
      <th>More info</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date&.strftime("%B %-d, %Y") %></td>
        <td><%= link_to "Show this movie", movie %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="4"><%= pluralize(@movies.size, "movie") %> total</td>
    </tr>
  </tfoot>
</table>

<%= link_to "New movie", new_movie_path %>
