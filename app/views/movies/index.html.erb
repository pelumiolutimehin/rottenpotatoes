<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table id="movies">
  <thead>
    <tr>
      <th><%= sortable_header("Title", "title") %></th>
      <th><%= sortable_header("Rating", "rating") %></th>
      <th><%= sortable_header("Release date", "release_date") %></th>
      <th>More info</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date&.strftime("%B %-d, %Y") %></td>
        <td><%= link_to "Show this movie", movie %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="4"><%= pluralize(@movies.size, "movie") %> total</td>
    </tr>
  </tfoot>
</table>

<%= link_to "New movie", new_movie_path %>
